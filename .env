# Shared defaults for the ShopFlow returns platform.
# Values here are overridden by anything already present in the process environment.

SERVICE_ENVIRONMENT=local
KAFKA_BOOTSTRAP=localhost:9092

RETURNS_TOPIC=shopflow.returns.initiated
RETURNS_CONSUMER_GROUP=refund-service

PUBLISH_INTERVAL_SECONDS=2
POLL_TIMEOUT_SECONDS=1.0
HEALTH_PORT=8080
