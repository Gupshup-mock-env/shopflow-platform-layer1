{
  "broker": "rabbitmq",
  "exchanges": [
    {"name": "registration-service.events", "type": "topic", "durable": true}
  ],
  "queues": [
    {
      "name": "evt-registration-service-user_registered--welcome-service.send_welcome_email",
      "durable": true,
      "consumers": 1
    }
  ],
  "bindings": [
    {
      "source": "registration-service.events",
      "destination": "evt-registration-service-user_registered--welcome-service.send_welcome_email",
      "destination_type": "queue",
      "routing_key": "user_registered"
    }
  ]
}
