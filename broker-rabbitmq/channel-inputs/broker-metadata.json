{
  "broker": "rabbitmq",
  "exchanges": [
    {
      "name": "shopflow.notifications",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "vhost": "/"
    }
  ],
  "queues": [
    {
      "name": "email-service.inbox",
      "durable": true,
      "auto_delete": false,
      "exclusive": false,
      "consumers": 1,
      "messages": 0,
      "vhost": "/"
    }
  ],
  "bindings": [
    {
      "source": "shopflow.notifications",
      "destination": "email-service.inbox",
      "destination_type": "queue",
      "routing_key": "notification.email.#",
      "vhost": "/",
      "arguments": {}
    }
  ]
}
